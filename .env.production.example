APP_NAME="Bilad Al Rafidain"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://biladalrafidain.online
APP_PUBLIC_PATH=/home/CPANELUSER/public_html
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DAYS=7

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_DATABASE
DB_USERNAME=CPANELUSER_DBUSER
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

HOSTING_MODE=shared
HOSTING_JOBS_PER_TICK=20
HOSTING_WORKER_SECONDS=50
DOCUMENT_RENDERER=gd

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCOUNT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_BUSINESS_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_NOTIFICATIONS_PAUSED=true
WHATSAPP_CONVERSATION_DAYS=90
